<AnchorPane prefHeight="450.0" prefWidth="750.0" style="-fx-background-color: #122a24;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.bold.sudoku.controller.SudokuController">
   <children>

            <!-- Fondo blanco del tablero -->
      <Rectangle fill="white" height="300.0" layoutX="225.0" layoutY="75.0" stroke="black" strokeWidth="1" width="300.0" />

      <!-- Grid principal (6x6) -->
      <GridPane fx:id="sudokuGrid" alignment="CENTER" hgap="2" layoutX="225.0" layoutY="75.0" vgap="2">
         <children>

            <!-- Generación de 36 celdas -->
            <!-- Fila 0 -->
            <TextField fx:id="cell00" prefHeight="48" prefWidth="48" style="-fx-alignment: center;" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="cell01" prefHeight="48" prefWidth="48" style="-fx-alignment: center;" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <TextField fx:id="cell02" prefHeight="48" prefWidth="48" style="-fx-alignment: center;" GridPane.columnIndex="2" GridPane.rowIndex="0" />
            <TextField fx:id="cell03" prefHeight="48" prefWidth="48" style="-fx-alignment: center;" GridPane.columnIndex="3" GridPane.rowIndex="0" />
            <TextField fx:id="cell04" prefHeight="48" prefWidth="48" style="-fx-alignment: center;" GridPane.columnIndex="4" GridPane.rowIndex="0" />
            <TextField fx:id="cell05" prefHeight="48" prefWidth="48" style="-fx-alignment: center;" GridPane.columnIndex="5" GridPane.rowIndex="0" />

            <!-- Fila 1 -->
            <TextField fx:id="cell10" prefHeight="48" prefWidth="48" style="-fx-alignment: center;" GridPane.rowIndex="1" />
            <TextField fx:id="cell11" prefHeight="48" prefWidth="48" style="-fx-alignment: center;" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <TextField fx:id="cell12" prefHeight="48" prefWidth="48" style="-fx-alignment: center;" GridPane.columnIndex="2" GridPane.rowIndex="1" />
            <TextField fx:id="cell13" prefHeight="48" prefWidth="48" style="-fx-alignment: center;" GridPane.columnIndex="3" GridPane.rowIndex="1" />
            <TextField fx:id="cell14" prefHeight="48" prefWidth="48" style="-fx-alignment: center;" GridPane.columnIndex="4" GridPane.rowIndex="1" />
            <TextField fx:id="cell15" prefHeight="48" prefWidth="48" style="-fx-alignment: center;" GridPane.columnIndex="5" GridPane.rowIndex="1" />

            <!-- Fila 2 -->
            <TextField fx:id="cell20" prefHeight="48" prefWidth="48" style="-fx-alignment: center;" GridPane.rowIndex="2" />
            <TextField fx:id="cell21" prefHeight="48" prefWidth="48" style="-fx-alignment: center;" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <TextField fx:id="cell22" prefHeight="48" prefWidth="48" style="-fx-alignment: center;" GridPane.columnIndex="2" GridPane.rowIndex="2" />
            <TextField fx:id="cell23" prefHeight="48" prefWidth="48" style="-fx-alignment: center;" GridPane.columnIndex="3" GridPane.rowIndex="2" />
            <TextField fx:id="cell24" prefHeight="48" prefWidth="48" style="-fx-alignment: center;" GridPane.columnIndex="4" GridPane.rowIndex="2" />
            <TextField fx:id="cell25" prefHeight="48" prefWidth="48" style="-fx-alignment: center;" GridPane.columnIndex="5" GridPane.rowIndex="2" />

            <!-- Fila 3 -->
            <TextField fx:id="cell30" prefHeight="48" prefWidth="48" style="-fx-alignment: center;" GridPane.rowIndex="3" />
            <TextField fx:id="cell31" prefHeight="48" prefWidth="48" style="-fx-alignment: center;" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            <TextField fx:id="cell32" prefHeight="48" prefWidth="48" style="-fx-alignment: center;" GridPane.columnIndex="2" GridPane.rowIndex="3" />
