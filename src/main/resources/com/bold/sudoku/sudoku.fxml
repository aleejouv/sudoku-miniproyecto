            <TextField fx:id="cell52" prefHeight="48" prefWidth="48" style="-fx-alignment: center;" GridPane.columnIndex="2" GridPane.rowIndex="5" />
            <TextField fx:id="cell53" prefHeight="48" prefWidth="48" style="-fx-alignment: center;" GridPane.columnIndex="3" GridPane.rowIndex="5" />
            <TextField fx:id="cell54" prefHeight="48" prefWidth="48" style="-fx-alignment: center;" GridPane.columnIndex="4" GridPane.rowIndex="5" />
            <TextField fx:id="cell55" prefHeight="48" prefWidth="48" style="-fx-alignment: center;" GridPane.columnIndex="5" GridPane.rowIndex="5" />

         </children>
         <columnConstraints>
            <ColumnConstraints />
            <ColumnConstraints />
            <ColumnConstraints />
            <ColumnConstraints />
            <ColumnConstraints />
            <ColumnConstraints />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
         </rowConstraints>
      </GridPane>

      <!-- Líneas divisorias de bloques 2x3 -->
      <!-- horizontales después de fila 2 y 4 -->
      <Line endX="500.0" endY="200.0" layoutX="25.0" layoutY="-25.0" startX="200.0" startY="200.0" stroke="black" strokeWidth="3" />
      <Line endX="500.0" endY="300.0" layoutX="25.0" layoutY="-25.0" startX="200.0" startY="300.0" stroke="black" strokeWidth="3" />

      <!-- vertical después de columna 3 -->
      <Line endX="350.0" endY="400.0" layoutX="25.0" layoutY="-25.0" startX="350.0" startY="100.0" stroke="black" strokeWidth="3" />
      <Button fx:id="startSudoku" layoutX="572.0" layoutY="190.0" mnemonicParsing="false" prefHeight="36.0" prefWidth="97.0" style="-fx-background-color: #4d8170;" text="Inicio">
         <font>
            <Font name="MS Gothic" size="20.0" />
         </font>
      </Button>
      <Button fx:id="sudokuAyuda" layoutX="572.0" layoutY="228.0" mnemonicParsing="false" prefHeight="36.0" prefWidth="97.0" style="-fx-background-color: #4d8170;" text="Ayuda">
         <font>
            <Font name="MS Gothic" size="20.0" />
         </font>
      </Button>

