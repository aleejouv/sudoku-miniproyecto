            <TextField fx:id="cell41" prefHeight="48" prefWidth="48" style="-fx-alignment: center;" GridPane.columnIndex="1" GridPane.rowIndex="4" />
            <TextField fx:id="cell42" prefHeight="48" prefWidth="48" style="-fx-alignment: center;" GridPane.columnIndex="2" GridPane.rowIndex="4" />
            <TextField fx:id="cell43" prefHeight="48" prefWidth="48" style="-fx-alignment: center;" GridPane.columnIndex="3" GridPane.rowIndex="4" />
            <TextField fx:id="cell44" prefHeight="48" prefWidth="48" style="-fx-alignment: center;" GridPane.columnIndex="4" GridPane.rowIndex="4" />
            <TextField fx:id="cell45" prefHeight="48" prefWidth="48" style="-fx-alignment: center;" GridPane.columnIndex="5" GridPane.rowIndex="4" />

            <!-- Fila 5 -->
            <TextField fx:id="cell50" prefHeight="48" prefWidth="48" style="-fx-alignment: center;" GridPane.rowIndex="5" />
